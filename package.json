{
  "name": "signalk-plugin-ci-fixture-malicious-install-scripts",
  "version": "1.0.0",
  "description": "plugin-ci.yml fixture: preinstall/install/postinstall scripts that must never execute anywhere in the pipeline.",
  "main": "index.js",
  "scripts": {
    "preinstall": "node -e \"require('fs').appendFileSync('install-scripts-ran.log', 'preinstall\\n')\"",
    "install": "node -e \"require('fs').appendFileSync('install-scripts-ran.log', 'install\\n')\"",
    "postinstall": "node -e \"require('fs').appendFileSync('install-scripts-ran.log', 'postinstall\\n')\"",
    "test": "node --test"
  },
  "keywords": ["signalk-node-server-plugin"],
  "engines": {
    "node": ">=18.0.0"
  },
